# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY: Supabase project
# connection details, used by lib/supabaseClient.ts. The anon key is a publishable
# (client-safe) key, not a secret.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Your tool's database schema. DO NOT CHANGE.
NEXT_PUBLIC_TOOL_SCHEMA=pm

# Central portal SSO (lead sets these in Vercel after the domain is ready).
# NEXT_PUBLIC_COOKIE_DOMAIN: shared parent domain so the auth cookie spans subdomains
#   (e.g. .yourdomain.com in production; .localtest.me for local dev).
# NEXT_PUBLIC_PORTAL_LOGIN_URL: where middleware redirects when there's no session.
# NEXT_PUBLIC_PORTAL_URL: where sign-out sends the user.
NEXT_PUBLIC_COOKIE_DOMAIN=
NEXT_PUBLIC_PORTAL_LOGIN_URL=
NEXT_PUBLIC_PORTAL_URL=

# NEXT_PUBLIC_SITE_URL: base URL for self-referential links; local dev fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SUPABASE_SERVICE_ROLE_KEY: Secret key from Supabase Dashboard -> Settings -> API ->
# "service_role" secret. Grants full admin access (bypasses RLS, can create/delete auth
# users) — used ONLY by server-side code in app/api/admin/**/route.ts via
# lib/supabase/adminClient.ts. NEVER prefix this with NEXT_PUBLIC_ and never import
# lib/supabase/adminClient.ts from a 'use client' file — that would ship this secret to
# every visitor's browser.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
